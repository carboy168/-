{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "current_write_version", "readable_versions", "compatibility_policy", "schemas"],
  "properties": {
    "schema_version": {"const": 1},
    "registry_version": {"type": "string", "minLength": 1},
    "current_write_version": {"type": "string", "minLength": 1},
    "readable_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "compatibility_policy": {"type": "string", "minLength": 1},
    "schemas": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "hash_format", "status"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "hash_format": {"const": "canonical-json-v1"},
          "status": {"enum": ["frozen"]}
        }
      }
    }
  }
}
