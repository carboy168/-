{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://engineering-norm-agent.local/schema/engineering-knowledge-1.2-c1.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","package_id","question","normalized_question","objects","relations","topics","project_stage","user_role","user_claims","retrieval_plans","evidence_links","requirement_claims","warnings","human_confirmation_required","route_metadata","topic_graph","id_scope"],
  "properties":{
    "schema_version":{"const":"1.2-c1"},"package_id":{"type":"string","pattern":"^kp-[a-f0-9]{12}$"},
    "question":{"type":"string","minLength":1},"normalized_question":{"type":"string"},
    "objects":{"type":"array","items":{"$ref":"#/$defs/engineeringObject"}},
    "relations":{"type":"array","items":{"$ref":"#/$defs/engineeringRelation"}},
    "topics":{"type":"array","items":{"type":"object"}},"project_stage":{"type":"string"},"user_role":{"type":"string"},
    "user_claims":{"type":"array","items":{"type":"object"}},"retrieval_plans":{"type":"array","items":{"$ref":"#/$defs/retrievalPlan"}},
    "evidence_links":{"type":"array","items":{"$ref":"#/$defs/evidenceLink"}},"requirement_claims":{"type":"array","items":{"$ref":"#/$defs/requirementClaim"}},
    "warnings":{"type":"array","items":{"type":"string"}},"human_confirmation_required":{"type":"boolean"},
    "route_metadata":{"type":"object","required":["router_is_evidence"],"properties":{"router_is_evidence":{"const":false}}},
    "topic_graph":{"$ref":"#/$defs/topicGraph"},"id_scope":{"const":"package"}
  },
  "$defs":{
    "idScope":{"const":"package"},"confidence":{"enum":["low","medium","high"]},
    "stringList":{"type":"array","items":{"type":"string"}},
    "sourceSpan":{"type":"object","additionalProperties":false,"required":["source_id","start","end"],"properties":{"source_id":{"type":"string","minLength":1},"start":{"type":"integer","minimum":0},"end":{"type":"integer","minimum":0}}},
    "engineeringObject":{"type":"object","additionalProperties":false,"required":["object_id","object_type","canonical_name","original_text","aliases","profession","system","attributes","source_span","confidence","numeric_score","topic_hints","warnings","id_scope"],"properties":{
      "object_id":{"type":"string","pattern":"^obj-[0-9]{3,}$"},"object_type":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},"canonical_name":{"type":"string","minLength":1},"original_text":{"type":"string","minLength":1},
      "aliases":{"$ref":"#/$defs/stringList"},"profession":{"type":"string","minLength":1},"system":{"type":"string","minLength":1},"attributes":{"type":"object"},"source_span":{"$ref":"#/$defs/sourceSpan"},
      "confidence":{"$ref":"#/$defs/confidence"},"numeric_score":{"type":"number","minimum":0,"maximum":100},"topic_hints":{"$ref":"#/$defs/stringList"},"warnings":{"$ref":"#/$defs/stringList"},"id_scope":{"$ref":"#/$defs/idScope"}
    }},
    "engineeringRelation":{"type":"object","additionalProperties":false,"required":["relation_id","subject_object_id","relation_type","object_object_id","original_text","attributes","source_span","confidence","numeric_score","rule_id","topic_hints","evidence_links","verification_status","warnings","assertion_status","relation_relevant_for_retrieval","id_scope"],"properties":{
      "relation_id":{"type":"string","pattern":"^rel-[0-9]{3,}$"},"subject_object_id":{"type":"string","pattern":"^obj-[0-9]{3,}$"},"relation_type":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},"object_object_id":{"type":"string","pattern":"^obj-[0-9]{3,}$"},
      "original_text":{"type":"string","minLength":1},"attributes":{"type":"object"},"source_span":{"$ref":"#/$defs/sourceSpan"},"confidence":{"$ref":"#/$defs/confidence"},"numeric_score":{"type":"number","minimum":0,"maximum":100},
      "rule_id":{"type":"string","minLength":1},"topic_hints":{"$ref":"#/$defs/stringList"},"evidence_links":{"$ref":"#/$defs/stringList"},"verification_status":{"enum":["verified","unverified","rejected","blocked","superseded"]},"warnings":{"$ref":"#/$defs/stringList"},
      "assertion_status":{"enum":["affirmed","negated","conditional","uncertain"]},"relation_relevant_for_retrieval":{"type":"boolean"},"id_scope":{"$ref":"#/$defs/idScope"}
    }},
    "requirementClaim":{"type":"object","additionalProperties":false,"required":["claim_id","claim_type","source_type","source_id","source_locator","original_text","subject","property","operator","value","unit","action","conditions","exceptions","project_stage","normative_authority","project_binding","standard_status","verification_status","extraction_confidence","evidence_links","warnings","id_scope"],"properties":{
      "claim_id":{"type":"string","pattern":"^claim-[0-9]{3,}$"},"claim_type":{"enum":["numeric_requirement","method_requirement","material_requirement","prohibition_requirement","mandatory_requirement","acceptance_requirement","responsibility_requirement","sequence_requirement","normative_status_claim","evidence_bypass_request","unknown"]},
      "source_type":{"type":"string"},"source_id":{"type":"string","minLength":1},"source_locator":{"type":"object"},"original_text":{"type":"string","minLength":1},"subject":{"$ref":"#/$defs/stringList"},"property":{"type":"string"},"operator":{"type":"string"},"value":{"type":"string"},"unit":{"type":"string"},"action":{"type":"string"},
      "conditions":{"$ref":"#/$defs/stringList"},"exceptions":{"$ref":"#/$defs/stringList"},"project_stage":{"type":"string"},"normative_authority":{"type":"string"},"project_binding":{"type":"string"},"standard_status":{"type":"string"},"verification_status":{"enum":["verified","unverified","rejected","blocked","superseded","supported"]},"extraction_confidence":{"$ref":"#/$defs/confidence"},"evidence_links":{"$ref":"#/$defs/stringList"},"warnings":{"$ref":"#/$defs/stringList"},"id_scope":{"$ref":"#/$defs/idScope"}
    }},
    "evidenceLink":{"type":"object","additionalProperties":false,"required":["evidence_id","source_type","source_id","source_locator","original_text","standard_code","clause_no","page_no","drawing_no","document_name","status","normative_authority","project_binding","content_hash","verified","linked_object_ids","linked_relation_ids","linked_claim_ids","warnings","evidence_role","verification_status","id_scope"],"properties":{
      "evidence_id":{"type":"string","pattern":"^ev-[A-Za-z0-9_-]+$"},"source_type":{"type":"string","minLength":1},"source_id":{"type":"string","minLength":1},"source_locator":{"type":"object"},"original_text":{"type":"string","minLength":1},"standard_code":{"type":"string"},"clause_no":{"type":"string"},"page_no":{"anyOf":[{"type":"integer","minimum":1},{"type":"null"}]},"drawing_no":{"type":"string"},"document_name":{"type":"string"},"status":{"type":"string"},"normative_authority":{"type":"string"},"project_binding":{"type":"string"},"content_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"verified":{"type":"boolean"},
      "linked_object_ids":{"$ref":"#/$defs/stringList"},"linked_relation_ids":{"$ref":"#/$defs/stringList"},"linked_claim_ids":{"$ref":"#/$defs/stringList"},"warnings":{"$ref":"#/$defs/stringList"},"evidence_role":{"enum":["normative_evidence","project_evidence","user_statement","derived_analysis","reference_only"]},"verification_status":{"enum":["verified","unverified","rejected","blocked","superseded"]},"id_scope":{"$ref":"#/$defs/idScope"}
    }},
    "retrievalPlan":{"type":"object","additionalProperties":false,"required":["topic_id","preferred_standard_codes","query_terms","object_ids","relation_ids","evidence_gate","plan_id","profession","reason","required_entities","required_relations","project_stage","intent","required_evidence_role","evidence_status","confidence","expanded_query_terms","id_scope"],"properties":{
      "topic_id":{"type":"string","minLength":1},"preferred_standard_codes":{"$ref":"#/$defs/stringList"},"query_terms":{"$ref":"#/$defs/stringList"},"object_ids":{"$ref":"#/$defs/stringList"},"relation_ids":{"$ref":"#/$defs/stringList"},"evidence_gate":{"const":"requires_clause_evidence"},"plan_id":{"type":"string","pattern":"^plan-[0-9]{3,}$"},"profession":{"type":"string"},"reason":{"type":"string","minLength":1},"required_entities":{"$ref":"#/$defs/stringList"},"required_relations":{"$ref":"#/$defs/stringList"},"project_stage":{"type":"string"},"intent":{"type":"string"},"required_evidence_role":{"const":"normative_evidence"},"evidence_status":{"enum":["verified","unverified","rejected","blocked","superseded"]},"confidence":{"$ref":"#/$defs/confidence"},"expanded_query_terms":{"$ref":"#/$defs/stringList"},"id_scope":{"$ref":"#/$defs/idScope"}
    }},
    "topicNode":{"type":"object","additionalProperties":false,"required":["topic_id","profession","system","confidence"],"properties":{"topic_id":{"type":"string"},"profession":{"type":"string"},"system":{"type":"string"},"confidence":{"$ref":"#/$defs/confidence"}}},
    "topicEdge":{"type":"object","additionalProperties":false,"required":["source_topic_id","edge_type","target_topic_id","relation_ids","assertion_status","relevant_for_retrieval","reason"],"properties":{"source_topic_id":{"type":"string"},"edge_type":{"enum":["intersects_with","located_in","requires_coordination_with","affects"]},"target_topic_id":{"type":"string"},"relation_ids":{"$ref":"#/$defs/stringList"},"assertion_status":{"enum":["affirmed","negated","conditional","uncertain"]},"relevant_for_retrieval":{"type":"boolean"},"reason":{"type":"string"}}},
    "topicGraph":{"type":"object","additionalProperties":false,"required":["nodes","edges"],"properties":{"nodes":{"type":"array","items":{"$ref":"#/$defs/topicNode"}},"edges":{"type":"array","items":{"$ref":"#/$defs/topicEdge"}}}}
  }
}
