{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://engineering-norm-agent.local/schema/engineering-objects-1.2-c1.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","catalog_version","object_types"],
  "properties":{
    "schema_version":{"const":1},"catalog_version":{"type":"string","pattern":"^1\\.2-c[0-9]+$"},
    "object_types":{"type":"array","minItems":24,"items":{"type":"object","additionalProperties":false,"required":["object_type","canonical_name","aliases","profession","system","topic_hints"],"properties":{
      "object_type":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},"canonical_name":{"type":"string","minLength":1},
      "aliases":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
      "profession":{"type":"string","minLength":1},"system":{"type":"string","minLength":1},
      "topic_hints":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_]*$"}}
    }}}
  }
}
