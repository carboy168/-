{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://engineering-norm-agent.local/schema/engineering-relations-1.2-c1.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","catalog_version","relation_types","rules"],
  "properties":{
    "schema_version":{"const":1},"catalog_version":{"type":"string","pattern":"^1\\.2-c[0-9]+$"},
    "relation_types":{"type":"array","minItems":13,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"}},
    "rules":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["rule_id","relation_type","expressions","mode","subject_types","object_types","max_distance","score","topic_hints"],"properties":{
      "rule_id":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"},"relation_type":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},
      "expressions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
      "mode":{"enum":["between","two_before","container_before_all"]},
      "subject_types":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"}},
      "object_types":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"}},
      "max_distance":{"type":"integer","minimum":1,"maximum":200},"score":{"type":"number","minimum":0,"maximum":100},
      "topic_hints":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_]*$"}}
    }}}
  }
}
