{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schema_version","gate_version","minimum_app_version","benchmark","protected_paths","commands"],
  "properties":{
    "schema_version":{"const":1},"gate_version":{"const":"1.3-d"},"minimum_app_version":{"type":"string","pattern":"^[0-9]+[.][0-9]+[.][0-9]+$"},
    "benchmark":{"type":"object","additionalProperties":false,"required":["runner_version","required_suites","minimum_test_count"],"properties":{"runner_version":{"type":"string","minLength":1},"required_suites":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"minimum_test_count":{"type":"integer","minimum":1}}},
    "protected_paths":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "commands":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","args","timeout_seconds"],"properties":{"id":{"type":"string","minLength":1},"args":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"timeout_seconds":{"type":"integer","minimum":1}}}}
  }
}
