{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schema_version","benchmark_version","cases","safety_boundaries"],
  "properties":{
    "schema_version":{"const":1},"benchmark_version":{"const":"1.3-d"},
    "cases":{"type":"array","minItems":8,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["id","expected"],"properties":{"id":{"type":"string","minLength":1},"expected":{"type":"string","minLength":1}}}},
    "safety_boundaries":{"type":"array","minItems":4,"uniqueItems":true,"items":{"type":"string","minLength":1}}
  }
}
