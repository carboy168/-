    {"rule_id":"responsibility","claim_type":"responsibility_requirement","terms":["应由","负责","责任"],"priority":85,"confidence":"high"},
    {"rule_id":"sequence","claim_type":"sequence_requirement","terms":["施工前","施工后","安装前","安装后","封闭前","验收前","验收后"],"priority":80,"confidence":"high"},
    {"rule_id":"material","claim_type":"material_requirement","terms":["材料","材质","强度等级","燃烧性能","防火性能"],"priority":75,"confidence":"medium"},
