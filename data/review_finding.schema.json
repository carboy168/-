{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["finding_id","fingerprint","source_type","source_claims","norm_claims","conflict_type","evidence_links","severity","status","assignee","reviewer","created_time","updated_time","history","discovery_mode","assignment_role","confirmed_by","confirmed_time","confirmation_note","rectification_note","expected_finish","review_time","close_reason","reevaluation_required","revision"],
  "properties":{
    "finding_id":{"type":"string","minLength":1},
    "fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "source_type":{"type":"string","minLength":1},
    "source_claims":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "norm_claims":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "conflict_type":{"type":"string","minLength":1},
    "evidence_links":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "severity":{"enum":["high","medium","low"]},
    "status":{"enum":["detected","pending_confirmation","confirmed","assigned","rectifying","pending_review","closed","reopened"]},
    "assignee":{"type":"string"},"reviewer":{"type":"string"},
    "created_time":{"type":"string","minLength":1},"updated_time":{"type":"string","minLength":1},
    "history":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["action","user","time","note","metadata"],"properties":{"action":{"type":"string","minLength":1},"user":{"type":"string","minLength":1},"time":{"type":"string","minLength":1},"note":{"type":"string"},"metadata":{"type":"object"}}}},
    "discovery_mode":{"enum":["deterministic","model_assisted"]},
    "assignment_role":{"enum":["","owner","contractor","designer","supervision","other"]},
    "confirmed_by":{"type":"string"},"confirmed_time":{"type":"string"},"confirmation_note":{"type":"string"},
    "rectification_note":{"type":"string"},"expected_finish":{"type":"string"},"review_time":{"type":"string"},"close_reason":{"type":"string"},
    "reevaluation_required":{"type":"boolean"},"revision":{"type":"integer","minimum":1}
  }
}
