{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://engineering-norm-agent.local/schema/topic-router-1.3-a.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","router_version","site_terms","project_stages","user_roles","project_binding_terms","evidence_model","topics"],
  "properties":{
    "schema_version":{"const":1},
    "router_version":{"const":"1.3-a"},
    "site_terms":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/normalization"}},
    "project_stages":{"type":"array","minItems":6,"items":{"$ref":"#/$defs/contextRule"}},
    "user_roles":{"type":"array","minItems":7,"items":{"$ref":"#/$defs/contextRule"}},
    "project_binding_terms":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/bindingRule"}},
    "evidence_model":{
      "type":"object","additionalProperties":false,
      "required":["normative_authority","project_binding","rule"],
      "properties":{
        "normative_authority":{"$ref":"#/$defs/stringList"},
        "project_binding":{"$ref":"#/$defs/stringList"},
        "rule":{"type":"string","minLength":1}
      }
    },
    "topics":{"type":"array","minItems":20,"maxItems":64,"items":{"$ref":"#/$defs/topic"}}
  },
  "$defs":{
    "stringList":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "weightedTerm":{
      "type":"object","additionalProperties":false,"required":["term","weight"],
      "properties":{"term":{"type":"string","minLength":1},"weight":{"type":"number","minimum":0,"maximum":100}}
    },
    "threshold":{
      "type":"object","additionalProperties":false,"required":["high","medium"],
      "properties":{"high":{"type":"number","minimum":1,"maximum":100},"medium":{"type":"number","minimum":1,"maximum":100}}
    },
    "normalization":{
      "type":"object","additionalProperties":false,"required":["original","normalized"],
      "properties":{"original":{"type":"string","minLength":1},"normalized":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}}
    },
    "contextRule":{
      "type":"object","additionalProperties":false,"required":["value","aliases","terms","confidence_threshold"],
      "properties":{
        "value":{"type":"string","minLength":1},"aliases":{"$ref":"#/$defs/stringList"},
        "terms":{"type":"array","items":{"$ref":"#/$defs/weightedTerm"}},
        "query_expansions":{"$ref":"#/$defs/stringList"},"confidence_threshold":{"$ref":"#/$defs/threshold"}
      }
    },
    "bindingRule":{
      "type":"object","additionalProperties":false,"required":["value","terms"],
      "properties":{"value":{"type":"string","minLength":1},"terms":{"$ref":"#/$defs/stringList"}}
    },
    "subtopicTerms":{
      "type":"object","additionalProperties":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
    },
    "topic":{
      "type":"object","additionalProperties":false,
      "required":["topic_id","profession","topic","subtopics","aliases","site_terms","positive_terms","negative_terms","governing_standards","primary_standards","companion_standards","query_expansions","confidence_threshold"],
      "properties":{
        "topic_id":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},
        "profession":{"type":"string","minLength":1},"topic":{"type":"string","minLength":1},
        "subtopics":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "subtopic_terms":{"$ref":"#/$defs/subtopicTerms"},"aliases":{"$ref":"#/$defs/stringList"},
        "site_terms":{"$ref":"#/$defs/stringList"},"phrases":{"$ref":"#/$defs/stringList"},
        "positive_terms":{"type":"array","items":{"$ref":"#/$defs/weightedTerm"}},
        "negative_terms":{"type":"array","items":{"$ref":"#/$defs/weightedTerm"}},
        "context_terms":{"$ref":"#/$defs/stringList"},
        "governing_standards":{"$ref":"#/$defs/stringList"},"primary_standards":{"$ref":"#/$defs/stringList"},
        "companion_standards":{"$ref":"#/$defs/stringList"},"query_expansions":{"$ref":"#/$defs/stringList"},
        "confidence_threshold":{"$ref":"#/$defs/threshold"}
      }
    }
  }
}
