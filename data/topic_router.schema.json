{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["schema_version","router_version","site_terms","project_stages","user_roles","project_binding_terms","evidence_model","topics"],
  "properties":{
    "schema_version":{"type":"integer","minimum":1},
    "router_version":{"type":"string"},
    "site_terms":{"type":"array"},
    "project_stages":{"type":"array","minItems":6},
    "user_roles":{"type":"array","minItems":7},
    "project_binding_terms":{"type":"array","minItems":1},
    "evidence_model":{"type":"object","required":["normative_authority","project_binding","rule"]},
    "topics":{"type":"array","minItems":1,"items":{"type":"object","required":["topic_id","profession","topic","subtopics","aliases","site_terms","positive_terms","negative_terms","governing_standards","primary_standards","companion_standards","query_expansions","confidence_threshold"]}}
  }
}
